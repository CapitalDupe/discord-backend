// Source of truth for the data model. Migrations live in prisma/migrations.
// Target: PostgreSQL (Neon or self-hosted). All ids are time-sortable strings generated by the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
  STAGE
  FORUM
  MEDIA
  DM
  GROUP_DM
}

enum ServerVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum PresenceStatus {
  ONLINE
  IDLE
  BUSY
  INVISIBLE
  OFFLINE
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  NEW_DEVICE
  STEP_UP
}

enum ModActionType {
  KICK
  BAN
  UNBAN
  TIMEOUT
  UNTIMEOUT
  WARN
  MESSAGE_DELETE
  LOCKDOWN
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  REGISTER
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_DONE
  MFA_ENABLED
  MFA_DISABLED
  MFA_FAILURE
  NEW_DEVICE
  SESSION_REVOKED
  RATE_LIMITED
  CHALLENGE_ISSUED
  CHALLENGE_FAILED
  INVITE_ABUSE
  SPAM_DETECTED
  RAID_DETECTED
  IP_RESTRICTION_ADDED
  IP_RESTRICTION_REMOVED
  ADMIN_ACTION
  ACCOUNT_DELETED
}

enum SiteRole {
  USER
  SUPPORT
  SECURITY
  ADMIN
}

enum AutomodKind {
  WORD_FILTER
  MENTION_SPAM
  LINK_FILTER
  INVITE_FILTER
  SPAM_RATE
}

enum AutomodAction {
  BLOCK
  FLAG
  TIMEOUT
}

enum NotifLevel {
  ALL
  MENTIONS
  NONE
}

model User {
  id                String         @id
  email             String
  emailNormalized   String         @unique
  emailVerifiedAt   DateTime?
  username          String
  usernameLower     String         @unique
  displayName       String
  passwordHash      String // Argon2id
  avatarKey         String?
  bannerKey         String?
  bio               String         @default("")
  accentColor       String         @default("#5865f2")
  customStatus      String?
  presence          PresenceStatus @default(ONLINE)
  showPresence      Boolean        @default(true)
  showReadReceipts  Boolean        @default(true)
  birthDate         DateTime?
  siteRole          SiteRole       @default(USER)
  isBot             Boolean        @default(false)
  isSystem          Boolean        @default(false)
  // TOTP secret is AES-256-GCM encrypted with a key from env (never stored plaintext)
  totpSecretEnc     String?
  totpEnabledAt     DateTime?
  phoneHash         String?
  phoneVerifiedAt   DateTime?
  failedLogins      Int            @default(0)
  lockedUntil       DateTime?
  deletedAt         DateTime? // soft-delete marker; hard purge after retention window
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sessions          Session[]
  devices           Device[]
  emailTokens       EmailToken[]
  backupCodes       BackupCode[]
  passkeys          Passkey[]
  oauthAccounts     OAuthAccount[]
  memberships       Member[]
  ownedServers      Server[]       @relation("ServerOwner")
  messages          Message[]
  reactions         Reaction[]
  dmParticipants    ChannelParticipant[]
  readStates        ReadState[]
  notifications     Notification[]
  notifPrefs        NotificationPreference[]
  pushSubscriptions PushSubscription[]
  reportsMade       Report[]       @relation("ReportReporter")
  reportsAgainst    Report[]       @relation("ReportTarget")
  modActionsTarget  ModAction[]    @relation("ModTarget")
  modActionsActor   ModAction[]    @relation("ModActor")
  bot               Bot?
  drafts            Draft[]
  savedMessages     SavedMessage[]
  exportJobs        DataExportJob[]

  @@index([deletedAt])
}

model Session {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshHash    String    @unique // SHA-256 of opaque refresh token; rotated on every use
  familyId       String // refresh-token family for replay detection
  userAgent      String?
  mfaVerifiedAt  DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Device {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  uaHash     String
  trustedAt  DateTime?
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  sessions   Session[]

  @@unique([userId, uaHash])
}

model EmailToken {
  id         String         @id
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       EmailTokenType
  tokenHash  String         @unique // only the hash of the token is stored
  attempts   Int            @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime       @default(now())

  @@index([userId, type, createdAt])
}

model BackupCode {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Passkey {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[]
  label        String   @default("Passkey")
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model OAuthAccount {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model Server {
  id                 String           @id
  name               String
  description        String           @default("")
  iconKey            String?
  bannerKey          String?
  theme              Json?
  visibility         ServerVisibility @default(PRIVATE)
  ownerId            String
  owner              User             @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  rulesText          String?
  requireRulesAccept Boolean          @default(false)
  minAccountAgeHours Int              @default(0)
  requireVerifiedEmail Boolean        @default(false)
  requireApproval    Boolean          @default(false)
  welcomeMessage     String?
  systemChannelId    String?
  lockdownUntil      DateTime?
  discoverable       Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  roles              Role[]
  members            Member[]
  channels           Channel[]
  categories         Category[]
  invites            Invite[]
  bans               Ban[]
  auditLogs          AuditLog[]
  automodRules       AutomodRule[]
  reports            Report[]
  modActions         ModAction[]
  modNotes           ModNote[]
  bots               BotInstall[]
  webhooks           Webhook[]
  templates          ServerTemplate[]
  customEmoji        CustomEmoji[]
  forumTags          ForumTag[]
  pendingJoins       JoinRequest[]

  @@index([visibility, discoverable])
}

model Role {
  id          String       @id
  serverId    String
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int // higher = more powerful; @everyone is 0
  permissions BigInt
  isDefault   Boolean      @default(false)
  mentionable Boolean      @default(false)
  members     MemberRole[]
  overwrites  ChannelOverwrite[]
  createdAt   DateTime     @default(now())

  @@unique([serverId, name])
  @@index([serverId, position])
}

model Member {
  serverId       String
  userId         String
  server         Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String?
  joinedAt       DateTime     @default(now())
  rulesAcceptedAt DateTime?
  screeningDoneAt DateTime?
  timeoutUntil   DateTime?
  roles          MemberRole[]

  @@id([serverId, userId])
  @@index([userId])
}

model MemberRole {
  serverId String
  userId   String
  roleId   String
  member   Member @relation(fields: [serverId, userId], references: [serverId, userId], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serverId, userId, roleId])
  @@index([roleId])
}

model Category {
  id       String    @id
  serverId String
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  position Int
  channels Channel[]

  @@index([serverId, position])
}

model Channel {
  id            String      @id
  serverId      String?
  server        Server?     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type          ChannelType
  name          String
  topic         String      @default("")
  position      Int         @default(0)
  slowModeSecs  Int         @default(0)
  nsfw          Boolean     @default(false)
  maxParticipants Int       @default(0)
  archived      Boolean     @default(false)
  parentChannelId String?
  parentChannel Channel?    @relation("Threads", fields: [parentChannelId], references: [id], onDelete: Cascade)
  threads       Channel[]   @relation("Threads")
  parentMessageId String?   @unique
  autoArchiveAt DateTime?
  createdAt     DateTime    @default(now())

  overwrites    ChannelOverwrite[]
  messages      Message[]
  participants  ChannelParticipant[]
  readStates    ReadState[]
  voiceSessions VoiceParticipant[]
  forumTags     ForumPostTag[]
  pins          Pin[]

  @@index([serverId, position])
  @@index([parentChannelId])
}

model ChannelOverwrite {
  id        String  @id
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId    String?
  allow     BigInt  @default(0)
  deny      BigInt  @default(0)

  @@unique([channelId, roleId])
  @@unique([channelId, userId])
}

model ChannelParticipant {
  channelId String
  userId    String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  @@id([channelId, userId])
  @@index([userId])
}

model ForumTag {
  id       String          @id
  serverId String
  server   Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  posts    ForumPostTag[]

  @@unique([serverId, name])
}

model ForumPostTag {
  channelId String
  tagId     String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tag       ForumTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([channelId, tagId])
}

model Invite {
  code        String    @id
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channelId   String?
  createdById String?
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([serverId])
  @@index([expiresAt])
}

model JoinRequest {
  id        String   @id
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  answers   Json?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  decidedBy String?

  @@unique([serverId, userId])
}

model ServerTemplate {
  id        String   @id
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name      String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([serverId])
}

model CustomEmoji {
  id       String @id
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name     String
  fileKey  String

  @@unique([serverId, name])
}

model Message {
  id          String    @id
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  webhookId   String?
  content     String
  contentTsv  Unsupported("tsvector")?
  replyToId   String?
  replyTo     Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[] @relation("Replies")
  nonce       String?
  mentionEveryone Boolean @default(false)
  mentionUserIds  String[]
  mentionRoleIds  String[]
  mentionChannelIds String[]
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?
  flagged     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  attachments Attachment[]
  reactions   Reaction[]
  pin         Pin?
  reports     Report[]
  saved       SavedMessage[]
  linkPreviews LinkPreview[]

  @@unique([channelId, authorId, nonce])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
}

model Attachment {
  id          String   @id
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId  String
  objectKey   String   @unique
  filename    String
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationMs  Int?
  isVoiceMessage Boolean @default(false)
  scanStatus  String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([uploaderId])
}

model LinkPreview {
  id        String   @id
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  description String?
  imageUrl  String?
  siteName  String?
  fetchedAt DateTime @default(now())

  @@index([messageId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model Pin {
  messageId String   @id
  channelId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy  String
  pinnedAt  DateTime @default(now())

  @@index([channelId, pinnedAt])
}

model SavedMessage {
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, messageId])
}

model Draft {
  userId    String
  channelId String
  content   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@id([userId, channelId])
}

model ReadState {
  userId        String
  channelId     String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadId    String?
  mentionCount  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@id([userId, channelId])
}

model Notification {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  data      Json
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  userId     String
  scopeType  String
  scopeId    String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      NotifLevel @default(ALL)
  muteUntil  DateTime?
  desktop    Boolean    @default(true)
  push       Boolean    @default(false)

  @@id([userId, scopeType, scopeId])
}

model PushSubscription {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model VoiceParticipant {
  id         String    @id
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  isSpeaker  Boolean   @default(true)
  muted      Boolean   @default(false)
  deafened   Boolean   @default(false)

  @@index([channelId, leftAt])
  @@index([userId])
}

model Recording {
  id          String   @id
  channelId   String
  startedById String
  consentLog  Json
  objectKey   String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
}

model Ban {
  serverId  String
  userId    String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  reason    String?
  bannedBy  String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@id([serverId, userId])
}

model ModAction {
  id         String        @id
  serverId   String
  server     Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type       ModActionType
  targetId   String?
  target     User?         @relation("ModTarget", fields: [targetId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?         @relation("ModActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime      @default(now())
  appeals    Appeal[]

  @@index([serverId, createdAt(sort: Desc)])
  @@index([targetId])
}

model Appeal {
  id          String       @id
  modActionId String
  modAction   ModAction    @relation(fields: [modActionId], references: [id], onDelete: Cascade)
  userId      String
  text        String
  status      AppealStatus @default(PENDING)
  decidedBy   String?
  decisionNote String?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  @@index([status, createdAt])
}

model Report {
  id          String       @id
  serverId    String?
  server      Server?      @relation(fields: [serverId], references: [id], onDelete: SetNull)
  reporterId  String
  reporter    User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser  User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  messageId   String?
  message     Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reason      String
  evidence    Json?
  status      ReportStatus @default(OPEN)
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([serverId, status, createdAt])
}

model ModNote {
  id        String   @id
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  authorId  String
  note      String
  createdAt DateTime @default(now())

  @@index([serverId, userId])
}

model AutomodRule {
  id        String        @id
  serverId  String
  server    Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name      String
  kind      AutomodKind
  config    Json
  action    AutomodAction @default(BLOCK)
  enabled   Boolean       @default(true)
  exemptRoleIds String[]
  createdAt DateTime      @default(now())

  @@index([serverId, enabled])
}

// Tamper-evident audit trail: hash = SHA-256(prevHash | canonical(row)); insert-only (trigger in migration).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  serverId  String?
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String
  targetType String?
  targetId  String?
  metadata  Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([serverId, createdAt(sort: Desc)])
  @@index([actorId])
}

// Raw IPs live ONLY here. Access is restricted to SECURITY/ADMIN, every read is audited, rows are purged after IP_RETENTION_DAYS.
model SecurityEvent {
  id        String            @id
  type      SecurityEventType
  userId    String?
  ip        String
  ipPrefix  String
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt])
}

model IpRestriction {
  id        String    @id
  cidr      String
  reason    String
  level     String
  createdBy String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model SecurityAccessLog {
  id        String   @id
  actorId   String
  action    String
  subject   String?
  reason    String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model DataExportJob {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  objectKey   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model Bot {
  id            String        @id
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerId       String
  name          String
  description   String        @default("")
  tokenHash     String        @unique
  scopes        String[]
  rateLimitPerMin Int         @default(120)
  endpointUrl   String?
  signingSecretEnc String?
  createdAt     DateTime      @default(now())

  installs      BotInstall[]
  commands      SlashCommand[]
}

model BotInstall {
  botId       String
  serverId    String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  permissions BigInt
  config      Json?
  installedBy String
  installedAt DateTime @default(now())

  @@id([botId, serverId])
}

model SlashCommand {
  id          String   @id
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name        String
  description String
  options     Json?
  createdAt   DateTime @default(now())

  @@unique([botId, name])
}

model Webhook {
  id          String    @id
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channelId   String
  name        String
  tokenHash   String    @unique
  secretEnc   String
  prevSecretEnc String?
  prevSecretUntil DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([serverId])
}

model ReplayNonce {
  nonce     String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model IdempotencyKey {
  key        String   @id
  userId     String
  response   Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
