# Copy to .env on the server. Never commit .env.

# Neon connection string (Neon console -> Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# People must enter this code to create an account. Generate: openssl rand -hex 12
SIGNUP_CODE=change-me

# Exact origin of the frontend (no trailing slash, no path)
ALLOWED_ORIGIN=https://capitaldupe.github.io

# Hostname Caddy gets a certificate for (DuckDNS A record -> this VPS)
DOMAIN=pondered.duckdns.org
