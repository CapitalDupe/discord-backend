PORT=3000
# Required: Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://user:pass@localhost:5432/discord
# If set, people must enter this code to create an account. Strongly recommended.
SIGNUP_CODE=change-me
ALLOWED_ORIGIN=https://capitaldupe.github.io
# Set to 1 only when behind exactly one reverse proxy (Render, nginx) so client IPs are read correctly
TRUST_PROXY=
