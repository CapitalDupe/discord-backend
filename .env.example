# Copy to .env. Placeholders only; never commit real secrets.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0

# Postgres. For Neon: DATABASE_URL = pooled host (-pooler), DIRECT_URL = direct host. Keep sslmode=require.
# The `schema=app` parameter isolates this app's tables in their own Postgres schema.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&schema=app
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&schema=app
REDIS_URL=redis://localhost:6379

# Generate: openssl rand -hex 32   /   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
IP_RETENTION_DAYS=30
METRICS_TOKEN=

# Mail: smtp | composio | log
MAIL_TRANSPORT=log
MAIL_FROM=Chat <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
COMPOSIO_API_KEY=

# S3-compatible storage (MinIO in development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Voice / video (self-hosted LiveKit + coturn)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
TURN_URLS=turn:localhost:3478?transport=udp
TURN_SECRET=CHANGE_ME
TURN_TTL_SEC=600
FORCE_RELAY=false

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
