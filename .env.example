# Copy to .env on the server. Never commit .env.
# (The NestJS rewrite's variables are in .env.nest.example.)

# Neon connection string (Neon console -> Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Leave EMPTY for open sign-ups (anyone, any region). Set a value to require that code to register.
SIGNUP_CODE=

# Global cap on new accounts per hour (flood protection for open sign-ups). Default 200.
MAX_SIGNUPS_PER_HOUR=200

# Secret for posting as the Official account (POST /api/official/announce, header X-Admin-Key).
# Generate: openssl rand -hex 24   (leave empty to disable the endpoint)
ADMIN_KEY=

# Exact origin of the frontend (no trailing slash, no path)
ALLOWED_ORIGIN=https://capitaldupe.github.io

# Hostname Caddy gets a certificate for (DuckDNS A record -> this VPS)
DOMAIN=pondered.duckdns.org

# error | warn | info | debug
LOG_LEVEL=info
